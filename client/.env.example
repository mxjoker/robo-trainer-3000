# Required for progress photo uploads.
# Create a free Cloudinary account at https://cloudinary.com
# Then create an unsigned upload preset in Settings > Upload > Upload presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Optional: override the backend API URL (defaults to /api)
# VITE_API_URL=http://localhost:3001/api
